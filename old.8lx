const neg=a=>[-a[0],-a[1]];
const minus=(a,b)=>plus(a,neg(cv(b)));
const mul=(a,b)=>{a=cv(a);b=cv(b);return [a[0]*b[0]-a[1]*b[1],a[0]*b[1]+a[1]*b[0]]};
const abs=a=>Math.hypot(a[0],a[1]);
