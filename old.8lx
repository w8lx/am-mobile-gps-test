function envParams(fkhz,sigma,epsilon=15,earthFactor=4/3){
  const f=fkhz*1000,k=2*PI*f/C0*1000,a=A_KM*earthFactor;
  const nu=Math.cbrt(a*k/2),eta=c(epsilon,-(sigma/1000)/(2*PI*f*EPS0));
