// Airy Ai' roots. Universal dimensionless zeros are *not* propagation tables;
// they anchor a direct Taylor evaluation of Ai and Ai' for modal root solving.
const AIRY_DERIV_ROOTS = [
-1.0187929716474715,-3.2481975821798375,-4.8200992111787384,-6.1633073556393247,
-7.3721772550496336,-8.4884867340197214,-9.5354490524335471,-10.5276603969574065,
-11.4750566334802446,-12.3847883718457474,-13.2622189616652122,-14.1115019704629958,
-14.9359371967205181,-15.7382013736925401,-16.5205038254337957,-17.2846950502164347,
-18.0323446225043966,-18.7647984376659558,-19.4832216565672312,-20.1886315094633737,
-20.8819227555167366,-21.5638877231989738,-22.2352322853489142,-22.8965887388746232,
-23.5485262959288058,-24.1915597095263557,-24.8261564259211553,-25.4527425617776508,
-26.0717079351739152,-26.6834103283224522,-27.2881791215239851,-27.8863184087684601,
-28.4781096831022786,-29.0638141626381952,-29.6436748146320177,-30.2179181244685751,
-30.7867556480125053,-31.3503853790830362,-31.9089929584304670,-32.4627527462384791
];
// Use polynomial solution of y''=(z0+h)y with y(z0)=1, y'(z0)=0.
// The scale drops out of the Robin root condition and stays well conditioned
// because each root is sought within roughly 1.3 of its Ai' zero.
function airyNearZero(z,z0){
  const h=minus(z,c(z0)), a=[c(1),c(0)];
  let y=c(1),dy=c(0),hn=c(1);
  for(let n=0;n<75;n++){
    if(n>=2){a[n]=div(plus(mul(c(z0),a[n-2]),n>=3?a[n-3]:c(0)),c(n*(n-1)));}
    if(n>0){dy=plus(dy,mul(mul(c(n),a[n]),div(hn,h)));}
    y=plus(y,mul(a[n],hn));
    hn=mul(hn,h);
    if(n>20 && abs(mul(a[n],hn))<1e-16*Math.max(1,abs(y)))break;
  }
  return [y,dy];
}
// Revised Horner Airy Taylor (avoids derivative division when h=0).
function airyAt(z,z0){
  let a0=c(1),a1=c(0),arr=[a0,a1];
  for(let n=2;n<75;n++)arr.push(div(plus(mul(c(z0),arr[n-2]),n>=3?arr[n-3]:c(0)),c(n*(n-1))));
  let val=c(0),der=c(0),h=minus(z,c(z0));
  for(let n=arr.length-1;n>=0;n--){der=plus(mul(der,h),val); val=plus(mul(val,h),arr[n]);}
  return [val,der];
