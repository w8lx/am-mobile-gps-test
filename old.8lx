  if(flip)yi=-yi;
  let zz=c(xr,yi),N=11,h=Math.sqrt(PI/(N+1)),H=PI/h, z2=mul(zz,zz);
  let az=mul(c(0,2/H),zz),sum=c(0);
  const buff=Math.abs(xr/h-Math.floor(xr/h)-0.5);
  const mode=yi>=Math.max(xr,H)?1:(yi<xr&&buff<=0.25?2:3);
  if(mode===2){
    for(let n=1;n<=N;n++){let t=h*n;sum=plus(sum,div(c(Math.exp(-t*t)),minus(z2,c(t*t))));}
    let ch=div(c(2),mul(exp(z2),minus(c(1),exp(mul(c(0,-2*H),zz)))));
    sum=plus(plus(div(c(0,1/H),zz),mul(az,sum)),ch);
  }else{
    for(let n=0;n<=N;n++){let t=h*(n+0.5);sum=plus(sum,div(c(Math.exp(-t*t)),minus(z2,c(t*t))));}
    sum=mul(az,sum);
    if(mode===3){let ch=div(c(2),mul(exp(z2),plus(c(1),exp(mul(c(0,-2*H),zz)))));sum=plus(sum,ch);}
  }
  if(flip)sum=c(sum[0],-sum[1]);
  if(yneg)sum=minus(mul(c(2),exp(neg(mul(original,original)))),sum);
