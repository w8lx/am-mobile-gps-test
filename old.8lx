const modeCache=new Map();
function modalRoots(q,n=40){
  let key=`${q[0].toPrecision(14)}:${q[1].toPrecision(14)}:${n}`;
  if(modeCache.has(key))return modeCache.get(key);
  const roots=AIRY_DERIV_ROOTS.slice(0,n).map(z=>rootFor(q,z));
  if(roots.some(z=>!Number.isFinite(z[0])||!Number.isFinite(z[1])||z[1]>=0))throw Error('Invalid spherical mode');
  modeCache.set(key,roots);
