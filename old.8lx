  if(abs(q)>0.1){
    const term1=minus(minus(c(1),mul(mul(c(0,SQPI),sqrt(p)),c(1))),mul(plus(c(1),mul(c(2),p)),F));
    // Important: Python uses sqrt(pi*p), principal complex sqrt (not sqrt(pi)*sqrt(p) variant).
    const partA=minus(c(1),mul(mul(c(0,SQPI),sqrt(p)),minus(c(1),p)));
    const partB=plus(minus(partA,mul(c(2),p)),mul(c(5/6),mul(p,p)));
    const term2=plus(partB,mul(minus(mul(c(0.5),mul(p,p)),c(1)),F));
    g=plus(plus(F,div(term1,mul(c(4),pow(q,3)))),div(term2,mul(c(4),pow(q,6))));
  }else{
    const q3=pow(q,3),q6=pow(q,6),q9=pow(q,9),j=I;
    const cf=[c(1),c(0,-SQPI),c(-2),mul(c(0,SQPI),plus(c(1),div(c(1),mul(c(4),q3)))),mul(c(4/3),plus(c(1),div(c(1),mul(c(2),q3)))),mul(c(0,-SQPI/4),plus(c(1),div(c(3),mul(c(4),q3)))),mul(c(-8/15),plus(plus(c(1),div(c(1),q3)),div(c(7),mul(c(32),q6)))),mul(c(0,SQPI/6),plus(plus(c(1),div(c(5),mul(c(4),q3))),div(c(27),mul(c(32),q6)))),mul(c(16/105),plus(plus(c(1),div(c(3),mul(c(2),q3))),div(c(27),mul(c(32),q6)))),mul(c(0,-SQPI/24),plus(plus(plus(c(1),div(c(7),mul(c(4),q3))),div(c(5),mul(c(4),q6))),div(c(21),mul(c(64),q9))))];
    const x=d/a*nu,z=mul(mul(c(Math.SQRT1_2,Math.SQRT1_2),q),c(Math.sqrt(x)));
    g=c(0); for(let n=cf.length-1;n>=0;n--)g=plus(mul(g,z),cf[n]);
  }
  return abs(g)*100/d;
}
function longField(fkhz,sigma,d,epsilon=15,earthFactor=4/3){
  const {a,nu,q}=envParams(fkhz,sigma,epsilon,earthFactor),x=nu*d/a,roots=modalRoots(q,40),q2=mul(q,q);
  let g=c(0);
  for(let t of roots)g=plus(g,div(exp(mul(c(0,-x),t)),minus(t,q2)));
  return 100/d*Math.sqrt(PI*x)*abs(g);
}
function uniformGroundwave(fkhz,sigma,d,epsilon=15,earthFactor=4/3){
  if(![fkhz,sigma,d,epsilon,earthFactor].every(x=>Number.isFinite(x)&&x>0))throw Error('Invalid homogeneous inputs');
  const crossover=80/Math.cbrt(fkhz/1000);
  const field=d<crossover?shortField(fkhz,sigma,d,epsilon,earthFactor):longField(fkhz,sigma,d,epsilon,earthFactor);
  if(!(field>0&&Number.isFinite(field)))throw Error('Invalid groundwave field');
  return {field_mv_m:field,additional_loss_db:-20*Math.log10(field/(100/d)),inverse_distance_mv_m:100/d,method:d<crossover?'flat_earth_curvature_corrected':'spherical_residue_series',crossover_km:crossover};
}
function kirkeGroundwave(fkhz,sections){
  if(!sections.length)throw Error('Empty groundwave sections');
  const cache=new Map();
  const curve=(s,d)=>{if(d<=0)throw Error('Invalid positive distance');let key=`${s.conductivity_mS_m}/${s.epsilon_r}/${d}`;if(!cache.has(key))cache.set(key,uniformGroundwave(fkhz,s.conductivity_mS_m,d,s.epsilon_r).field_mv_m);return cache.get(key);};
  const inverse=(s,target,guess)=>{
    let lo=0.001,hi=Math.min(3000,Math.max(1,guess));if(curve(s,lo)<target)throw Error('Near field range exceeded');
    while(curve(s,hi)>target){if(hi>=3000)throw Error('Equivalent distance beyond model');hi=Math.min(3000,hi*2);}
    for(let n=0;n<56;n++){let mid=(lo+hi)/2;if(curve(s,mid)>target)lo=mid;else hi=mid;if(hi-lo<1e-9)break;}
    return (lo+hi)/2;
  };
  let actual=0,equiv=0,prior=null,refField=null,transitions=[];
  for(let s of sections){
    if(!(s.length_km>0&&s.conductivity_mS_m>0&&s.epsilon_r>0))throw Error('Invalid section');
    if(prior&&(prior.conductivity_mS_m!==s.conductivity_mS_m||prior.epsilon_r!==s.epsilon_r)){
      const boundary=curve(prior,equiv),old=equiv;
      equiv=inverse(s,boundary,equiv);
      transitions.push({actual_km:actual,from_conductivity_ms_m:prior.conductivity_mS_m,to_conductivity_ms_m:s.conductivity_mS_m,field_mv_m:boundary,equivalent_distance_km:equiv,old_equivalent_distance_km:old});
    }
    actual+=s.length_km;equiv+=s.length_km;refField=curve(s,equiv); prior=s;
  }
  return {actual_distance_km:actual,field_mv_m:refField,additional_loss_db:-20*Math.log10(refField/(100/actual)),equivalent_distance_km:equiv,transitions};
}
const _test={wofz,airyAt,rootFor,modalRoots,envParams,shortField,longField};

return {uniformGroundwave, kirkeGroundwave};
})();
const M3GeographicEngine = (() => {
/* Research browser port of m3_path_profile.py (spherical great-circle mode).
 * Polygon boundaries from experimental m3v2 GeoJSON. Original 236 preserved.
 * Unknown water material remains fail-closed. Zone 99 8 mS/m baseline
 * is accepted for research use while keeping its provisional source label.
 */
const R=6371.0088, RAD=Math.PI/180, DEG=180/Math.PI, GRID=.5;
function pointAt(origin,bearing,d){
  const la=origin[0]*RAD,lo=origin[1]*RAD,br=bearing*RAD,ad=d/R;
  const lat2=Math.asin(Math.sin(la)*Math.cos(ad)+Math.cos(la)*Math.sin(ad)*Math.cos(br));
  const lon2=lo+Math.atan2(Math.sin(br)*Math.sin(ad)*Math.cos(la),Math.cos(ad)-Math.sin(la)*Math.sin(lat2));
  return [lat2*DEG, ((lon2*DEG+540)%360)-180];
}
function distanceBearing(a,b){
 const la=a[0]*RAD,lb=b[0]*RAD,dl=(b[1]-a[1])*RAD;
 const h=Math.sin((lb-la)/2)**2+Math.cos(la)*Math.cos(lb)*Math.sin(dl/2)**2;
 const d=2*R*Math.asin(Math.min(1,Math.sqrt(h)));
 const y=Math.sin(dl)*Math.cos(lb),x=Math.cos(la)*Math.sin(lb)-Math.sin(la)*Math.cos(lb)*Math.cos(dl);
 return [d,((Math.atan2(y,x)*DEG+360)%360)];
}
function bboxRing(r){let minx=Infinity,maxx=-Infinity,miny=Infinity,maxy=-Infinity;for(let [x,y] of r){minx=Math.min(minx,x);maxx=Math.max(maxx,x);miny=Math.min(miny,y);maxy=Math.max(maxy,y)}return [minx,miny,maxx,maxy];}
const cell=(x,y)=>`${Math.floor(x/GRID)},${Math.floor(y/GRID)}`;
function inRing(pt,ring){let [x,y]=pt,inside=false;for(let i=0,j=ring.length-1;i<ring.length;j=i++){let a=ring[i],b=ring[j];if(((a[1]>y)!==(b[1]>y)) && x<(b[0]-a[0])*(y-a[1])/(b[1]-a[1])+a[0])inside=!inside;}return inside;}
function intersects(a,b,c,d){
 let rx=b[0]-a[0],ry=b[1]-a[1],sx=d[0]-c[0],sy=d[1]-c[1];
 let det=rx*sy-ry*sx;
 if(Math.abs(det)<1e-15)return null;
 let qx=c[0]-a[0],qy=c[1]-a[1];
 let t=(qx*sy-qy*sx)/det,u=(qx*ry-qy*rx)/det;
 return t>=0&&t<=1&&u>=0&&u<=1?t:null;
}
class M3Geography {
 constructor(geojson){
  if(geojson.type!=='FeatureCollection')throw Error('Expected FCC M-3 FeatureCollection');
  // Experimental coastal trims can divide a source zone into disconnected
  // MultiPolygon components. Flatten components for the existing polygon
  // classifier while retaining their exact original properties and zone IDs.
  this.features=geojson.features.flatMap(f=>{
   const geometry=f.geometry;
   const components=geometry.type==='Polygon'?[geometry.coordinates]:
      geometry.type==='MultiPolygon'?geometry.coordinates:null;
   if(!components)throw Error('Unsupported M-3 geometry: '+geometry.type);
   return components.map(rings=>({props:f.properties,rings,bbox:bboxRing(rings[0])}));
  });
  this.edges=[];this.grid=new Map();this.fallback=[];
  for(let fi=0;fi<this.features.length;fi++){
   const f=this.features[fi];
   for(const ring of f.rings){
    for(let j=1;j<ring.length;j++){
     const a=ring[j-1],b=ring[j]; const id=this.edges.length;
     this.edges.push([a,b]);
     const ix0=Math.floor(Math.min(a[0],b[0])/GRID), ix1=Math.floor(Math.max(a[0],b[0])/GRID);
     const iy0=Math.floor(Math.min(a[1],b[1])/GRID), iy1=Math.floor(Math.max(a[1],b[1])/GRID);
     if((ix1-ix0+1)*(iy1-iy0+1)>1500){this.fallback.push(id);continue;}
     for(let ix=ix0;ix<=ix1;ix++)for(let iy=iy0;iy<=iy1;iy++){
      const key=`${ix},${iy}`; if(!this.grid.has(key))this.grid.set(key,[]);this.grid.get(key).push(id);
     }
    }
   }
  }
 }
 classify(lat,lon){
  let matches=[];
  for(let f of this.features){let [x0,y0,x1,y1]=f.bbox;if(lon<x0||lon>x1||lat<y0||lat>y1)continue;
    if(inRing([lon,lat],f.rings[0]) && !f.rings.slice(1).some(r=>inRing([lon,lat],r)))matches.push(f.props);
  }
  if(matches.length!==1)return {zone_id:null,conductivity_mS_m:null,status:matches.length?'overlapping_polygons':'not_mapped',material:'unknown'};
  const p=matches[0],sigma=p.conductivity_mS_m;
  let material='land';
  if(String(p.assignment_basis||'').startsWith('we7w_lake_erie_28')||String(p.assignment_basis||'').startsWith('lake_fragment_without_source_label')||p.assignment_basis==='adjacent_lake_erie_freshwater_analogy')material='freshwater';
  else if(p.material==='seawater' && sigma===5000 && p.relative_permittivity===80)material='seawater';
  else if(sigma!==null&&sigma>=1000)material='high_conductivity_water_candidate';
  return {zone_id:p.id,conductivity_mS_m:sigma,status:p.status||'status_missing',material,assignment_basis:p.assignment_basis||null};
 }
 profile(origin,destination,maxStepKm=0.5){
  const [total,bearing]=distanceBearing(origin,destination);
  if(!(total>0&&total<20050))throw Error('Invalid distance');
  const n=Math.max(1,Math.ceil(total/maxStepKm)),coords=[];
  for(let i=0;i<=n;i++){let p=pointAt(origin,bearing,total*i/n);coords.push([p[1],p[0]]);}
  coords[coords.length-1]=[destination[1],destination[0]];
  let crossings=[0,total],visits=new Set();
  for(let i=0;i<n;i++){
    const a=coords[i],b=coords[i+1],minx=Math.min(a[0],b[0]),maxx=Math.max(a[0],b[0]),miny=Math.min(a[1],b[1]),maxy=Math.max(a[1],b[1]);
    const possible=new Set(this.fallback);
    for(let ix=Math.floor(minx/GRID);ix<=Math.floor(maxx/GRID);ix++)for(let iy=Math.floor(miny/GRID);iy<=Math.floor(maxy/GRID);iy++){
      for(let idx of this.grid.get(`${ix},${iy}`)||[])possible.add(idx);
    }
    for(let idx of possible){let [c,d]=this.edges[idx],t=intersects(a,b,c,d);if(t!==null)crossings.push(total*(i+t)/n);}
  }
  crossings.sort((a,b)=>a-b);
  let unique=[crossings[0]];
  for(let x of crossings.slice(1))if(x-unique[unique.length-1]>0.00001)unique.push(x);
  unique[unique.length-1]=total;
  let segments=[];
  for(let i=1;i<unique.length;i++){
    let a=unique[i-1],b=unique[i];if(b-a<=0)continue;
    const pt=pointAt(origin,bearing,(a+b)/2),info=this.classify(...pt);
    let prev=segments[segments.length-1];
    if(prev&&prev.zone_id===info.zone_id&&prev.conductivity_mS_m===info.conductivity_mS_m&&prev.status===info.status&&prev.material===info.material&&prev.assignment_basis===info.assignment_basis){prev.end_km=b;prev.length_km=b-prev.start_km;}
    else segments.push({start_km:a,end_km:b,length_km:b-a,...info});
  }
  const unresolved=segments.filter(s=>s.conductivity_mS_m==null), pendingWater=segments.filter(s=>s.material!=='land' && !(s.material==='freshwater' && s.conductivity_mS_m===28) && !(s.material==='seawater' && s.conductivity_mS_m===5000));
  const hasMappedLake=segments.some(s=>s.material==='freshwater' && s.conductivity_mS_m===28);
  const hasMarine=segments.some(s=>s.material==='seawater');
  return {distance_km:total,initial_bearing_deg:bearing,segments,status:unresolved.length||pendingWater.length?'REVIEW_REQUIRED':hasMarine?'EXPERIMENTAL_MARINE_PATH':segments.some(s=>s.status==='provisional_baseline')?(hasMappedLake?'PROVISIONAL_MIXED_PATH':'PROVISIONAL_LAND_ONLY'):(hasMappedLake?'ASSIGNED_MIXED_PATH':'ASSIGNED_LAND_ONLY')};
 }
 sectionsForKirke(profile){
  let sections=[];
  for(let s of profile.segments){
   if(!(s.conductivity_mS_m>0))throw Error(`Unassigned M-3 area at ${s.start_km.toFixed(2)} km`);
   // FCC M-3 assigned Lake Erie at 28 mS/m: use the FCC 15-epsilon groundwave family.
   // Reserve epsilon=80 for verified seawater (the 5000 mS/m FCC curve), not freshwater.
   // No silent material substitution for other water candidates or unassigned polygons.
   if(s.material==='freshwater' && s.conductivity_mS_m!==28)throw Error(`Unsupported freshwater assignment at ${s.start_km.toFixed(2)} km`);
   if(s.material==='seawater' && s.conductivity_mS_m!==5000)throw Error(`Unsupported seawater assignment at ${s.start_km.toFixed(2)} km`);
   if(s.material!=='land' && s.material!=='freshwater' && s.material!=='seawater')throw Error(`Unresolved M-3 material at ${s.start_km.toFixed(2)} km`);
   if(s.status==='provisional_baseline' && !(s.assignment_basis==='zone99_source_8_land_baseline_with_external_lake_mask'&&s.conductivity_mS_m===8))throw Error(`Unresolved provisional zone ${s.zone_id}`);
   const epsilon=s.material==='seawater'?80:15;
   let prev=sections[sections.length-1];
   if(prev&&prev.conductivity_mS_m===s.conductivity_mS_m&&prev.epsilon_r===epsilon)prev.length_km+=s.length_km;
   else sections.push({length_km:s.length_km,conductivity_mS_m:s.conductivity_mS_m,epsilon_r:epsilon});
  }
  return sections;
 }
}

return {M3Geography};
})();
const M3_GEOJSON_URL = 'https://raw.githubusercontent.com/w8lx/AMDB_Master/main/data/m3v3.geojson';
try {
  const response = await fetch(M3_GEOJSON_URL, {cache: 'no-store'});
  if (!response.ok) throw new Error(`M-3 GeoJSON fetch failed: HTTP ${response.status}`);
  const geography = new M3GeographicEngine.M3Geography(await response.json());
  const marineCount=geography.features.filter(f=>f.props.material==='seawater' && f.props.conductivity_mS_m===5000 && f.props.relative_permittivity===80).length;
  if(geography.features.length<237 || marineCount===0) throw Error('M-3 v2 marine geography missing or incompatible');
  window.m3Research = {
    geography,
    kirkeGroundwave: GroundwaveEngine.kirkeGroundwave,
    uniformGroundwave: GroundwaveEngine.uniformGroundwave
  };
  window.dispatchEvent(new Event('m3ResearchReady'));
  console.info(`GitHub M-3 v2 geographic data ready: ${geography.features.length} polygons (${marineCount} seawater), original reference solver.`);
} catch (err) {
  console.error('GitHub M-3 geographic data unavailable:', err);
  window.m3ResearchLoadError = String(err);
  window.dispatchEvent(new Event('m3ResearchReady'));
}
</script>

</body>
</html>
