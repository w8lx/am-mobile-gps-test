function shortField(fkhz,sigma,d,epsilon=15,earthFactor=4/3){
  const {k,a,nu,q,delta}=envParams(fkhz,sigma,epsilon,earthFactor);
  const qi=mul(mul(c(-0.5,0.5),c(Math.sqrt(k*d))),delta), p=mul(qi,qi);
  const F=plus(c(1),mul(mul(c(0,SQPI),qi),wofz(qi)));
