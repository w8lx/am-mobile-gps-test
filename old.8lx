const exp=a=>{a=cv(a);let r=Math.exp(a[0]);return [r*Math.cos(a[1]),r*Math.sin(a[1])]};
const sqrt=a=>{a=cv(a);const r=abs(a);return [Math.sqrt(Math.max(0,(r+a[0])/2)),Math.sign(a[1]||1)*Math.sqrt(Math.max(0,(r-a[0])/2))]};
const pow=(a,n)=>{let r=c(1),v=cv(a); for(let k=0;k<n;k++)r=mul(r,v);return r};
